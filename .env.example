# Postgres (Neon or Supabase) - use the pooled connection string
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Magic-link auth secret (32+ random bytes)
AUTH_SECRET=change-me-to-a-long-random-string

# Public base URL of the app
APP_URL=http://localhost:3000

# Resend (email)
RESEND_API_KEY=re_xxx
EMAIL_FROM="Aravow <hello@aravow.com>"

# Cloudinary (signed direct uploads)
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=your-secret

# Paystack (NGN) — secret key only (sk_test_… for test, sk_live_… for live).
# The public key is NOT needed (hosted checkout, no inline JS).
PAYSTACK_SECRET_KEY=sk_test_xxx
# Webhook URL to register in the Paystack dashboard (Settings → API Keys &
# Webhooks → Test Webhook URL). Must be a full https:// URL:
#   https://your-domain/api/payments/webhook
