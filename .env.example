# Postgres (Neon or Supabase) - use the pooled connection string
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Magic-link auth secret (32+ random bytes)
AUTH_SECRET=change-me-to-a-long-random-string

# Public base URL of the app
APP_URL=http://localhost:3000

# Resend (email)
RESEND_API_KEY=re_xxx
EMAIL_FROM="Aravow <hello@aravow.com>"

# Cloudinary (signed direct uploads)
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=your-secret

# Bachs (NGN)
# Secret key from the Developer Portal (sk_live_… or sk_sandbox_…).
# The base URL is inferred from the prefix; override with BACHS_BASE_URL if needed.
BACHS_SECRET_KEY=sk_live_xxx
# Per-endpoint signing secret from the Webhooks tab — NOT the API key.
BACHS_WEBHOOK_SECRET=whsec_xxx
# Webhook URL to register in the Bachs dashboard:
#   {APP_URL}/api/payments/webhook
