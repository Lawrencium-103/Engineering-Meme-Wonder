# Production env — copy to .env.production on the server and fill in.
# NEVER commit this file with real values.

# Postgres (Neon pooled URL — NOT the local embedded DB)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Fresh random secret (generate: openssl rand -hex 32)
AUTH_SECRET=change-me-generate-a-fresh-one-with-openssl-rand-hex-32

# Must be the real domain (QR codes, magic links, emails all use this)
APP_URL=https://aravow.org

# Resend
RESEND_API_KEY=re_xxx
EMAIL_FROM="Aravow <hello@aravow.org>"

# Cloudinary (signed direct uploads)
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=your-secret

# Bachs (NGN payments)
BACHS_SECRET_KEY=sk_live_xxx
BACHS_WEBHOOK_SECRET=whsec_xxx

# Turnstile (bot protection on RSVP) — get from Cloudflare dashboard
NEXT_PUBLIC_TURNSTILE_SITE_KEY=xxx
TURNSTILE_SECRET_KEY=xxx
